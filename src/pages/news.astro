---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import NewsItem from '../components/content/NewsItem.astro';
import { getCollection, render } from 'astro:content';
import { groupBy } from '../utils/group';
import { yearOf } from '../utils/date';

const entries = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);

const items = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const hasBody = Boolean(entry.body && entry.body.trim().length > 0);
    return { entry, Content, hasBody };
  })
);

// 연도별로 묶는다. 이미 최신순이라 순서가 유지된다.
const years = groupBy(items, ({ entry }) => yearOf(entry.data.date));
---

<PageLayout title="소식">
  {
    years.map(([year, group]) => (
      <Section heading={year} large>
        <Fragment slot="aside">{group.length}건</Fragment>
        <ul class="news-list">
          {group.map(({ entry, Content, hasBody }) => (
            <NewsItem date={entry.data.date} title={entry.data.title} category={entry.data.category}>
              {hasBody && <Content />}
            </NewsItem>
          ))}
        </ul>
      </Section>
    ))
  }
</PageLayout>

<style>
  .news-list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.5vw, 2.25rem);
  }
</style>
