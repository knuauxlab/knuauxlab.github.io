---
import PageLayout from '../layouts/PageLayout.astro';
import AlbumItem from '../components/content/AlbumItem.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<PageLayout title="Album">
  <section class="wrap album-section">
    <div class="album-list">
      {
        entries.map(({ data }) => {
          const imgs =
            data.images && data.images.length > 0
              ? data.images
              : data.thumbnail
                ? [data.thumbnail]
                : [];
          return (
            <AlbumItem
              title={data.title}
              subtitle={data.subtitle}
              date={data.date}
              dateLabel={data.dateLabel}
              location={data.location}
              images={imgs}
            />
          );
        })
      }
    </div>
  </section>
</PageLayout>

<style>
  .album-section {
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
  }

  .album-list {
    display: flex;
    flex-direction: column;
  }
</style>
