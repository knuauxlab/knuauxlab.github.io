---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import ProjectItem from '../components/content/ProjectItem.astro';
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.start.localeCompare(a.data.start)
);

const projects = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    const hasBody = Boolean(entry.body && entry.body.trim().length > 0);
    return { entry, Content, hasBody };
  })
);
---

<PageLayout title="Projects" description="Funded research projects at AUX Lab, listed by funder and period.">
  {
    projects.map(({ entry, Content, hasBody }) => (
      <Section heading={entry.data.funder}>
        <Fragment slot="aside">
          {entry.data.start} — {entry.data.end ?? 'Ongoing'}
        </Fragment>
        <ProjectItem title={entry.data.title} summary={entry.data.summary}>
          {hasBody && <Content />}
        </ProjectItem>
      </Section>
    ))
  }
</PageLayout>
