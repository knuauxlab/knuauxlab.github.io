---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Section from '../components/layout/Section.astro';
import ResearchAreaItem from '../components/content/ResearchAreaItem.astro';
import NewsTimeline from '../components/content/NewsTimeline.astro';
import Button from '../components/ui/Button.astro';
import TextLink from '../components/ui/TextLink.astro';
import PdfViewer from '../components/ui/PdfViewer.astro';
import { withBase } from '../utils/url';
import { getCollection } from 'astro:content';
import { getLabInfo } from '../utils/lab';

const lab = await getLabInfo();

const researchAreas = (await getCollection('researchAreas', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const latestNews = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 5)
  .map(({ data }) => ({ date: data.date, title: data.title, category: data.category }));
---

<BaseLayout>
  <Hero affiliation={lab.affiliation} fullName={lab.fullName ?? lab.name} intro={lab.intro} />

  <Section heading="Research Areas">
    <div class="research-list">
      {
        researchAreas.map((area) => (
          <ResearchAreaItem title={area.data.title} summary={area.data.summary} />
        ))
      }
    </div>
  </Section>

  <Section heading="Lab Introduction" id="lab-intro">
    <p class="lead">An overview of AUX Lab’s research directions, sound-to-haptic conversion systems, and prototypes.</p>
    <div class="intro-actions">
      <Button href="/AUX_Lab_Introduction.pdf" external>View Fullscreen</Button>
      <TextLink href="/AUX_Lab_Introduction.pdf" download>Download PDF</TextLink>
    </div>
    <PdfViewer
      slot="below"
      src={withBase('/AUX_Lab_Introduction.pdf')}
      title="AUX Lab Introduction"
    />
  </Section>

  <Section heading="Latest News">
    <TextLink slot="aside" href="/news">View All News →</TextLink>
    <NewsTimeline items={latestNews} />
  </Section>
</BaseLayout>

<style>
  .research-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
</style>
