---
import BaseLayout from '../layouts/BaseLayout.astro';
import HapticDotCanvas from '../components/HapticDotCanvas.astro';
import { getCollection } from 'astro:content';

const labEntries = await getCollection('lab');
const lab = labEntries[0]?.data ?? {
  name: 'AUX Lab',
  fullName: 'Augmented User eXperience Laboratory',
  tagline: 'Multisensory Media, Haptics, HCI, and Virtual Reality',
  intro:
    'AUX Lab at Kyungpook National University researches multisensory media and human-computer interaction, focusing on real-time haptic effects generated from audio and visual stimuli using AI.',
  affiliation: 'School of Computer Science and Engineering, Kyungpook National University',
  address: 'IT College Bldg (E9), 80 Daehak-ro, Buk-gu, Daegu 41566, Republic of Korea',
  email: 'gyeoreyun@knu.ac.kr',
  phone: '+82-53-950-7554',
};

const researchAreas = (await getCollection('researchAreas', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const newsList = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<BaseLayout title={`${lab.name} — KNU`} description={lab.tagline}>
  <!-- Hero with Interactive Repulsion Dot Field -->
  <section class="hero-chapter" aria-label="AUX Lab Introduction">
    <HapticDotCanvas />

    <div class="wrap hero-inner">
      <div class="hero-content">
        <p class="small muted hero-affiliation">{lab.affiliation}</p>
        <div class="hero-title-row">
          <img src="/logo.png" alt="AUX Lab Logo" class="hero-logo" width="180" height="74" />
          <h1 class="display hero-headline">{lab.fullName}</h1>
        </div>
        <p class="lead hero-supporting">{lab.intro}</p>
        <div class="hero-actions">
          <a href="#lab-slides" class="button">Lab Introduction Slides</a>
          <a href="/publications" class="button button-ink">Publications</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Focus (3 Clean Columns) -->
  <section class="chapter chapter-surface" aria-labelledby="research-heading">
    <div class="wrap">
      <h2 id="research-heading" class="head section-heading" data-reveal>Research Focus</h2>
      <div class="research-grid grid" data-reveal>
        {
          researchAreas.map((area) => (
            <article class="research-item">
              <h3 class="lead research-title">{area.data.title}</h3>
              <p class="body-copy muted">{area.data.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Lab Introduction Slides (Embedded PDF + Download) -->
  <section id="lab-slides" class="chapter chapter-white" aria-labelledby="slides-heading">
    <div class="wrap">
      <div class="section-bar" data-reveal>
        <div>
          <h2 id="slides-heading" class="head">Lab Introduction</h2>
          <p class="body-copy muted">Overview of AUX Lab research directions, sound-to-haptic systems, and prototypes.</p>
        </div>
        <div class="slides-actions">
          <a href="/AUX_Lab_Introduction.pdf" target="_blank" rel="noopener noreferrer" class="button button-ink">
            Open Full Screen
          </a>
          <a href="/AUX_Lab_Introduction.pdf" download class="button button-surface">
            Download PDF
          </a>
        </div>
      </div>

      <div class="pdf-viewer-frame" data-reveal>
        <object
          data="/AUX_Lab_Introduction.pdf#view=FitH"
          type="application/pdf"
          class="pdf-object"
          aria-label="AUX Lab Introduction Slides"
        >
          <div class="pdf-fallback">
            <p class="lead">Your browser does not support inline PDF viewing.</p>
            <a href="/AUX_Lab_Introduction.pdf" target="_blank" rel="noopener noreferrer" class="button">
              View / Download Lab Introduction PDF
            </a>
          </div>
        </object>
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="chapter chapter-surface" aria-labelledby="news-heading">
    <div class="wrap">
      <div class="section-bar" data-reveal>
        <h2 id="news-heading" class="head">Latest News</h2>
        <a href="/news" class="text-link">View All News →</a>
      </div>

      <ul class="news-list" data-reveal>
        {
          newsList.slice(0, 5).map((item) => (
            <li class="news-row">
              <span class="news-date nums">{item.data.date}</span>
              <span class="news-title">{item.data.title}</span>
              <span class="tag tag-surface">{item.data.category}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-chapter {
    position: relative;
    min-height: 78svh;
    display: flex;
    align-items: center;
    background: var(--bg);
    padding-block: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    pointer-events: none;
  }

  .hero-content {
    max-width: 820px;
    background: rgba(255, 255, 255, 0.9);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    pointer-events: auto;
  }

  .hero-affiliation {
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .hero-title-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .hero-logo {
    height: clamp(3.2rem, 5.5vw, 4.6rem);
    width: auto;
    object-fit: contain;
  }

  .hero-headline {
    margin: 0;
  }

  .hero-supporting {
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .section-heading {
    margin-bottom: 2.25rem;
  }

  .section-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .research-item {
    grid-column: span 4;
    background: var(--bg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .research-title {
    font-weight: 700;
  }

  .slides-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pdf-viewer-frame {
    width: 100%;
    height: clamp(420px, 68vh, 760px);
    background: var(--surface);
  }

  .pdf-object {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .pdf-fallback {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 2rem;
    text-align: center;
  }

  .news-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .news-row {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 1.4rem;
    background: var(--bg);
  }

  .news-date {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--muted);
  }

  .news-title {
    font-weight: 600;
  }

  @media (max-width: 56em) {
    .research-item {
      grid-column: 1 / -1;
    }
    .news-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
