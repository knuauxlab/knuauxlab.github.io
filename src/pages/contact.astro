---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import TextLink from '../components/ui/TextLink.astro';
import { getLabInfo } from '../utils/lab';

const lab = await getLabInfo();
---

<PageLayout title="연락처">
  <Section heading="이메일">
    <p class="lead"><TextLink href={`mailto:${lab.email}`}>{lab.email}</TextLink></p>
  </Section>

  {
    lab.phone && (
      <Section heading="전화">
        <p class="lead nums">{lab.phone}</p>
      </Section>
    )
  }

  <Section heading="위치">
    <p class="lead">{lab.affiliation}</p>
    <p class="body-copy muted">{lab.address}</p>
  </Section>
</PageLayout>
