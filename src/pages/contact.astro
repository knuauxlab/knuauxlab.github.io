---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import TextLink from '../components/ui/TextLink.astro';
import { getCollection, render } from 'astro:content';
import { getLabInfo } from '../utils/lab';

const lab = await getLabInfo();
const instagramHandle = lab.instagram?.replace(/^@/, '');

const joinEntries = await getCollection('joinus');
const activeJoin = joinEntries.find((e) => !e.data.draft);
const renderedJoin = activeJoin ? await render(activeJoin) : null;
const JoinContent = renderedJoin?.Content;
---

<PageLayout title="Contact" description="Contact AUX Lab: email, phone, location, and open positions.">
  <div class="contact-sections">
    <Section heading="Open Positions">
      {
        JoinContent ? (
          <div class="body-copy">
            <JoinContent />
          </div>
        ) : (
          <div class="join-content">
            <p class="lead">
              We are looking for motivated graduate students (M.S., Ph.D., and B.S./M.S. Integrated) and undergraduate interns interested in haptics, HCI, virtual reality, and multisensory AI.
            </p>
            <p class="body-copy muted">
              If you are interested in building interactive prototypes, designing haptic interfaces, and conducting user experience research, please contact Prof. Gyeore Yun with your CV and a brief summary of your research interests.
            </p>
            <div>
              <Button href={`mailto:${lab.email}`}>Contact: {lab.email}</Button>
            </div>
          </div>
        )
      }
    </Section>

    {
      lab.phone && (
        <Section heading="Phone">
          <p class="lead nums">{lab.phone}</p>
        </Section>
      )
    }

    {
      instagramHandle && (
        <Section heading="Instagram">
          <p class="lead">
            <TextLink href={`https://www.instagram.com/${instagramHandle}/`} external>
              @{instagramHandle}
            </TextLink>
          </p>
        </Section>
      )
    }

    <Section heading="Location">
      <p class="lead">{lab.affiliation}</p>
      <p class="body-copy muted">{lab.address}</p>
    </Section>
  </div>
</PageLayout>

<style>
  .contact-sections :global(.section) {
    padding-block: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .join-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
