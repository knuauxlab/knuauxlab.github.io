---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const labEntries = await getCollection('lab');
const lab = labEntries[0]?.data ?? {
  name: 'AUX Lab',
  fullName: 'Augmented User eXperience Laboratory',
  affiliation: 'School of Computer Science and Engineering, Kyungpook National University',
  address: 'IT College Bldg (E9), 80 Daehak-ro, Buk-gu, Daegu 41566, Republic of Korea',
  email: 'gyeoreyun@knu.ac.kr',
  phone: '+82-53-950-7554',
};
---

<BaseLayout title="Contact — AUX Lab">
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display">Contact</h1>
    </div>
  </section>

  <section class="chapter chapter-white">
    <div class="wrap contact-grid">
      <div class="contact-card">
        <p class="small muted">Email</p>
        <a href={`mailto:${lab.email}`} class="lead text-link">{lab.email}</a>
      </div>

      <div class="contact-card">
        <p class="small muted">Phone</p>
        <p class="lead nums">{lab.phone ?? '+82-53-950-7554'}</p>
      </div>

      <div class="contact-card">
        <p class="small muted">Location</p>
        <p class="body-copy">
          <strong>{lab.affiliation}</strong><br />
          {lab.address}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .contact-card {
    background: var(--surface);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (max-width: 52em) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
