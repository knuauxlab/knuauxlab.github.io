---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import MemberCard from '../components/content/MemberCard.astro';
import { getCollection, render } from 'astro:content';
import { memberRoleLabels } from '../utils/labels';

const all = (await getCollection('members', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const members = await Promise.all(
  all.map(async (entry) => {
    const { Content } = await render(entry);
    const hasBody = Boolean(entry.body && entry.body.trim().length > 0);
    return { entry, Content: hasBody ? Content : undefined };
  })
);

const current = members.filter(({ entry }) => entry.data.status === 'current');
const groups = [
  {
    heading: 'Principal Investigator',
    large: true,
    people: current.filter(({ entry }) => entry.data.role === 'professor'),
  },
  {
    heading: 'Graduate Students',
    large: false,
    people: current.filter(({ entry }) => ['phd', 'ms', 'integrated'].includes(entry.data.role)),
  },
  {
    heading: 'Undergraduate Researchers',
    large: false,
    people: current.filter(({ entry }) => entry.data.role === 'undergraduate'),
  },
  {
    heading: 'Alumni',
    large: false,
    people: members.filter(({ entry }) => entry.data.status === 'alumni'),
  },
].filter((group) => group.people.length > 0);
---

<PageLayout title="Members">
  {
    groups.map(({ heading, large, people }) => (
      <Section heading={heading}>
        <div class:list={['member-grid', { 'is-large': large }]}>
          {people.map(({ entry, Content }) => (
            <MemberCard
              name={entry.data.name}
              role={memberRoleLabels[entry.data.role] ?? entry.data.role}
              photo={entry.data.photo}
              interests={entry.data.interests}
              email={entry.data.email}
              links={entry.data.links}
              large={large}
            >
              {Content && <Content />}
            </MemberCard>
          ))}
        </div>
      </Section>
    ))
  }
</PageLayout>

<style>
  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-6) var(--space-5);
  }

  /* 지도교수는 한 줄에 한 명 */
  .member-grid.is-large {
    grid-template-columns: minmax(0, 1fr);
  }
</style>
