---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, render } from 'astro:content';
import { getLabInfo } from '../utils/lab';

const lab = await getLabInfo();

const joinEntries = await getCollection('joinus');
const activeJoin = joinEntries.find((e) => !e.data.draft);
const renderedJoin = activeJoin ? await render(activeJoin) : null;
const JoinContent = renderedJoin?.Content;
---

<PageLayout title="모집 안내" description="AUX Lab의 대학원생, 학부연구생 모집 안내입니다.">
  <Section heading="모집 분야">
    {
      JoinContent ? (
        <div class="body-copy">
          <JoinContent />
        </div>
      ) : (
        <div class="join-content">
          <p class="lead">
            햅틱, HCI, 가상현실, 멀티센서리 AI에 관심 있는 대학원생(석사, 박사, 석박사통합과정)과 학부연구생을 찾고 있습니다.
          </p>
          <p class="body-copy muted">
            인터랙티브 프로토타입 제작, 햅틱 인터페이스 설계, 사용자 경험 연구에 관심이 있다면 이력서와 간단한 연구 관심사를 함께 Gyeore Yun 교수에게 연락해 주세요.
          </p>
          <div>
            <Button href={`mailto:${lab.email}`}>문의: {lab.email}</Button>
          </div>
        </div>
      )
    }
  </Section>
</PageLayout>

<style>
  .join-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
