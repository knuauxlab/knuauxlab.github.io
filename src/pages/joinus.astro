---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import { getCollection, render } from 'astro:content';
import { getLabInfo } from '../utils/lab';

const lab = await getLabInfo();

const joinEntries = await getCollection('joinus');
const activeJoin = joinEntries.find((e) => !e.data.draft);
const renderedJoin = activeJoin ? await render(activeJoin) : null;
const JoinContent = renderedJoin?.Content;
---

<PageLayout title="Join Us">
  <Section heading="Open Positions">
    {
      JoinContent ? (
        <div class="body-copy">
          <JoinContent />
        </div>
      ) : (
        <div class="join-content">
          <p class="lead">
            We are looking for motivated graduate students (M.S., Ph.D., and B.S./M.S. Integrated) and undergraduate interns interested in haptics, HCI, virtual reality, and multisensory AI.
          </p>
          <p class="body-copy muted">
            If you are interested in building interactive prototypes, designing haptic interfaces, and conducting user experience research, please contact Prof. Gyeore Yun with your CV and a brief summary of your research interests.
          </p>
          <div>
            <Button href={`mailto:${lab.email}`}>Contact: {lab.email}</Button>
          </div>
        </div>
      )
    }
  </Section>
</PageLayout>

<style>
  .join-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
