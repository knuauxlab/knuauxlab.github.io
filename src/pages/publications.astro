---
import PageLayout from '../layouts/PageLayout.astro';
import WithToc from '../components/layout/WithToc.astro';
import YearNav from '../components/layout/YearNav.astro';
import YearSection from '../components/layout/YearSection.astro';
import PublicationItem from '../components/content/PublicationItem.astro';
import { getCollection } from 'astro:content';
import { groupBy } from '../utils/group';
import { primaryLink } from '../utils/publication';

// 최신 연도가 위로, 같은 연도 안에서는 입력한 순서를 유지한다.
const publications = (await getCollection('publications', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year
);

const years = groupBy(publications, ({ data }) => String(data.year));
const toc = years.map(([year, group]) => ({ year, count: group.length }));
---

<PageLayout title="Publications">
  <WithToc>
    {
      years.map(([year, group]) => (
        <YearSection year={year} count={group.length}>
          <ul class="pub-list">
            {group.map(({ data }) => (
              <PublicationItem
                title={data.title}
                authors={data.authors}
                venue={data.venue}
                award={data.award}
                href={primaryLink(data.links)}
              />
            ))}
          </ul>
        </YearSection>
      ))
    }
    <YearNav slot="toc" years={toc} />
  </WithToc>
</PageLayout>

<style>
  .pub-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }
</style>
