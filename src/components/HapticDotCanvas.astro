<div class="haptic-field-shell" data-haptic-shell>
  <canvas class="haptic-canvas" data-haptic-canvas aria-hidden="true"></canvas>
</div>

<style>
  .haptic-field-shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .haptic-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  interface Dot {
    ox: number;
    oy: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    energy: number;
  }

  function initHapticFields() {
    const shells = document.querySelectorAll<HTMLElement>('[data-haptic-shell]');

    shells.forEach((shell) => {
      if (shell.dataset.initialized === 'true') return;
      shell.dataset.initialized = 'true';

      const canvas = shell.querySelector<HTMLCanvasElement>('[data-haptic-canvas]');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      let dots: Dot[] = [];

      const pointer = {
        x: -9999,
        y: -9999,
        active: false,
      };

      let time = 0;

      function buildGrid() {
        const rect = shell.getBoundingClientRect();
        width = Math.max(rect.width, 300);
        height = Math.max(rect.height, 400);
        dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas!.width = Math.floor(width * dpr);
        canvas!.height = Math.floor(height * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        const spacing = width < 640 ? 24 : width < 1100 ? 26 : 28;
        const cols = Math.floor(width / spacing) + 1;
        const rows = Math.floor(height / spacing) + 1;
        const offsetX = (width - (cols - 1) * spacing) / 2;
        const offsetY = (height - (rows - 1) * spacing) / 2;

        dots = [];
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const ox = offsetX + c * spacing;
            const oy = offsetY + r * spacing;
            dots.push({
              ox,
              oy,
              x: ox,
              y: oy,
              vx: 0,
              vy: 0,
              energy: 0,
            });
          }
        }
      }

      function updatePointer(clientX: number, clientY: number) {
        const rect = shell.getBoundingClientRect();
        const nx = clientX - rect.left;
        const ny = clientY - rect.top;
        pointer.x = nx;
        pointer.y = ny;
        pointer.active = nx >= -40 && nx <= width + 40 && ny >= -40 && ny <= height + 40;
      }

      const heroSection = shell.parentElement || document.body;

      heroSection.addEventListener(
        'pointermove',
        (e: PointerEvent) => {
          updatePointer(e.clientX, e.clientY);
        },
        { passive: true }
      );

      heroSection.addEventListener(
        'pointerdown',
        (e: PointerEvent) => {
          updatePointer(e.clientX, e.clientY);
        },
        { passive: true }
      );

      heroSection.addEventListener(
        'pointerleave',
        () => {
          pointer.active = false;
        },
        { passive: true }
      );

      function renderFrame() {
        time += 0.04;
        ctx!.clearRect(0, 0, width, height);

        const autoX = width * 0.72 + Math.cos(time * 0.4) * (width * 0.1);
        const autoY = height * 0.48 + Math.sin(time * 0.55) * (height * 0.08);

        const tx = pointer.active ? pointer.x : autoX;
        const ty = pointer.active ? pointer.y : autoY;
        const radius = pointer.active
          ? width < 640
            ? 140
            : 205
          : width < 640
            ? 90
            : 130;
        const radiusSq = radius * radius;

        const spring = 0.095;
        const damping = 0.78;

        for (let i = 0; i < dots.length; i++) {
          const d = dots[i];
          const dx = d.ox - tx;
          const dy = d.oy - ty;
          const distSq = dx * dx + dy * dy;

          let targetX = d.ox;
          let targetY = d.oy;
          let targetEnergy = 0;

          if (!prefersReducedMotion && distSq < radiusSq && distSq > 0.001) {
            const dist = Math.sqrt(distSq);
            const falloff = 1 - dist / radius;
            const easeFalloff = falloff * falloff * (3 - 2 * falloff);

            const ux = dx / dist;
            const uy = dy / dist;

            // Default tactile pressure repulsion
            const push = easeFalloff * (pointer.active ? 46 : 20);
            targetX = d.ox + ux * push;
            targetY = d.oy + uy * push;
            targetEnergy = easeFalloff;
          }

          d.vx = (d.vx + (targetX - d.x) * spring) * damping;
          d.vy = (d.vy + (targetY - d.y) * spring) * damping;
          d.x += d.vx;
          d.y += d.vy;
          d.energy += (targetEnergy - d.energy) * 0.18;

          const disp = Math.hypot(d.x - d.ox, d.y - d.oy);
          const norm = Math.min(1, Math.max(d.energy, disp / 34));

          const baseRadius = width < 640 ? 1.65 : 1.85;
          const r = baseRadius + norm * 2.25;

          ctx!.beginPath();
          ctx!.arc(d.x, d.y, r, 0, Math.PI * 2);

          if (norm > 0.14) {
            const t = Math.min(1, (norm - 0.14) / 0.7);
            const red = Math.round(15 + (254 - 15) * t);
            const green = Math.round(17 + (113 - 17) * t);
            const blue = Math.round(21 + (65 - 21) * t);
            const alpha = 0.28 + t * 0.72;
            ctx!.fillStyle = `rgba(${red}, ${green}, ${blue}, ${alpha.toFixed(2)})`;
          } else {
            ctx!.fillStyle = 'rgba(15, 17, 21, 0.22)';
          }

          ctx!.fill();
        }

        if (!prefersReducedMotion) {
          requestAnimationFrame(renderFrame);
        }
      }

      buildGrid();
      renderFrame();

      let resizeTimer: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          buildGrid();
          if (prefersReducedMotion) renderFrame();
        }, 120);
      });
    });
  }

  initHapticFields();
  document.addEventListener('astro:page-load', initHapticFields);
</script>
