---
// PDF를 페이지 안에서 미리 보여준다.
// 용량이 큰 파일(4MB대)이라 화면에 가까워질 때까지 받지 않는다. iframe의 loading="lazy"는
// 화면 아래 1250px 안쪽이면 미리 불러서, 스크롤하지 않아도 PDF를 받아 버린다.
// 또 일부 모바일 브라우저는 PDF를 페이지 안에서 보여주지 못해, 그때는 안내만 보여준다.
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="pdf-viewer" data-pdf-viewer data-src={`${src}#view=FitH`}>
  <iframe title={title} hidden></iframe>
  <p class="pdf-note muted" data-pdf-note hidden>
    This browser cannot show the PDF on this page. Use the buttons above to open it.
  </p>
  <noscript>
    <p class="pdf-note muted">JavaScript is required for the preview. Use the buttons above to open the PDF.</p>
  </noscript>
</div>

<script>
  function setupPdfViewers() {
    document.querySelectorAll<HTMLElement>('[data-pdf-viewer]').forEach((box) => {
      if (box.dataset.ready === 'true') return;
      box.dataset.ready = 'true';

      const iframe = box.querySelector<HTMLIFrameElement>('iframe');
      const note = box.querySelector<HTMLElement>('[data-pdf-note]');
      if (!iframe) return;

      // PDF를 페이지 안에서 못 보여주는 브라우저
      if (navigator.pdfViewerEnabled === false) {
        if (note) note.hidden = false;
        return;
      }

      const load = () => {
        iframe.src = box.dataset.src ?? '';
        iframe.hidden = false;
      };

      if (!('IntersectionObserver' in window)) {
        load();
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        },
        // 화면에 실제로 들어올 때 불러온다. 앞당겨 불러오면(예: 200px 앞) 뷰어가 첫 화면 바로 아래에
        // 놓인 레이아웃에서는 스크롤하기 전에 4MB를 받게 된다.
        { rootMargin: '0px' }
      );
      io.observe(box);
    });
  }

  setupPdfViewers();
  document.addEventListener('astro:page-load', setupPdfViewers);
</script>

<style>
  .pdf-viewer {
    width: 100%;
    height: clamp(30rem, 75vh, 54rem);
  }

  .pdf-viewer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pdf-note {
    padding-block: var(--space-6);
  }
</style>
