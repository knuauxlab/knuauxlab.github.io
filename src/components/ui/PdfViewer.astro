---
// PDF를 페이지 안에서 미리 보여준다.
// 용량이 큰 파일(4MB대)이라 화면에 가까워질 때까지 받지 않는다. iframe의 loading="lazy"는
// 화면 아래 1250px 안쪽이면 미리 불러서, 스크롤하지 않아도 PDF를 받아 버린다.
// 안드로이드 Chrome처럼 PDF를 페이지 안에서 보여주지 못하는 브라우저에서는,
// PDF를 쪽마다 이미지로 바꿔 둔 것(src/assets/intro/)을 옆으로 넘겨 보게 한다.
// PDF를 바꿨다면 `python scripts/pdf-to-images.py`로 이미지를 다시 만든다.
import { Image } from 'astro:assets';

interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;

const slides = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/intro/page-*.png', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<div class="pdf-viewer" data-pdf-viewer data-src={`${src}#zoom=68`}>
  <iframe title={title} hidden></iframe>

  {
    slides.length > 0 ? (
      <div class="pdf-slides" data-pdf-slides hidden>
        <ol class="slide-track" data-slide-track tabindex="0" aria-label={`${title}, slides`}>
          {slides.map((slide, i) => (
            <li class="slide">
              <Image
                src={slide}
                alt={`${title}, slide ${i + 1} of ${slides.length}`}
                width={1200}
                widths={[600, 900, 1200]}
                sizes="(min-width: 60rem) 60rem, 100vw"
                loading="lazy"
              />
            </li>
          ))}
        </ol>
        <div class="slide-nav">
          <button type="button" class="slide-btn" data-slide-prev>
            Previous
          </button>
          <span class="slide-count" data-slide-count aria-live="polite">
            1 / {slides.length}
          </span>
          <button type="button" class="slide-btn" data-slide-next>
            Next
          </button>
        </div>
      </div>
    ) : (
      <p class="pdf-note muted" data-pdf-note hidden>
        This browser cannot show the PDF on this page. Use the buttons above to open it.
      </p>
    )
  }

  <noscript>
    <p class="pdf-note muted">JavaScript is required for the preview. Use the buttons above to open the PDF.</p>
  </noscript>
</div>

<script>
  function setupSlides(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-slide-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-slide-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-slide-next]');
    const count = root.querySelector<HTMLElement>('[data-slide-count]');
    if (!track || !prev || !next || !count) return;

    const total = track.children.length;
    const current = () => Math.min(total - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
    const update = () => {
      const i = current();
      count.textContent = `${i + 1} / ${total}`;
      prev.disabled = i === 0;
      next.disabled = i === total - 1;
    };
    const go = (step: number) => track.scrollTo({ left: (current() + step) * track.clientWidth, behavior: 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });
    root.hidden = false;
    update();
  }

  function setupPdfViewers() {
    document.querySelectorAll<HTMLElement>('[data-pdf-viewer]').forEach((box) => {
      if (box.dataset.ready === 'true') return;
      box.dataset.ready = 'true';

      const iframe = box.querySelector<HTMLIFrameElement>('iframe');
      const note = box.querySelector<HTMLElement>('[data-pdf-note]');
      const slides = box.querySelector<HTMLElement>('[data-pdf-slides]');
      if (!iframe) return;

      // PDF를 페이지 안에서 못 보여주는 브라우저: 쪽별 이미지를 옆으로 넘겨 보게 한다.
      // 안드로이드 Chrome은 pdfViewerEnabled가 false가 아니어도 iframe의 PDF를 차단하고,
      // iPad Safari는 첫 쪽만 보여준다. 그래서 터치가 주 입력인 기기(폰, 태블릿)도 여기에 넣는다.
      const noInlinePdf = navigator.pdfViewerEnabled !== true || matchMedia('(pointer: coarse)').matches;
      if (noInlinePdf) {
        if (slides) setupSlides(slides);
        else if (note) note.hidden = false;
        return;
      }

      const load = () => {
        iframe.src = box.dataset.src ?? '';
        iframe.hidden = false;
      };

      if (!('IntersectionObserver' in window)) {
        load();
        return;
      }

      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            load();
            io.disconnect();
          }
        },
        // 화면에 실제로 들어올 때 불러온다. 앞당겨 불러오면(예: 200px 앞) 뷰어가 첫 화면 바로 아래에
        // 놓인 레이아웃에서는 스크롤하기 전에 4MB를 받게 된다.
        { rootMargin: '0px' }
      );
      io.observe(box);
    });
  }

  setupPdfViewers();
  document.addEventListener('astro:page-load', setupPdfViewers);
</script>

<style>
  .pdf-viewer {
    width: 100%;
    height: clamp(30rem, 75vh, 54rem);
  }

  .pdf-viewer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pdf-note {
    padding-block: var(--space-6);
  }

  /* 쪽별 이미지를 옆으로 넘겨 보는 대체 뷰어. PDF 뷰어가 있는 브라우저에서는 쓰지 않는다 */
  .pdf-viewer:has(.pdf-slides:not([hidden])) {
    height: auto;
  }

  .slide-track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .slide-track::-webkit-scrollbar {
    display: none;
  }

  .slide-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .slide :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .slide-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    font-size: var(--fs-small);
  }

  .slide-btn {
    padding: var(--space-2) 0;
    font: inherit;
    font-weight: var(--fw-semibold);
    color: var(--ink);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1.5px;
    cursor: pointer;
    transition: color var(--t-hover) ease;
  }

  .slide-btn:hover:not(:disabled) {
    color: var(--accent);
  }

  .slide-btn:disabled {
    color: var(--muted);
    text-decoration: none;
    cursor: default;
  }

  .slide-count {
    color: var(--muted);
  }
</style>
