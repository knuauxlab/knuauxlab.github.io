---
// PDF를 페이지 안에서 미리 보여준다. 용량이 큰 파일이라 화면 근처에 올 때까지 불러오지 않는다.
interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
---

<div class="pdf-viewer">
  <iframe src={`${src}#view=FitH`} title={title} loading="lazy"></iframe>
</div>

<style>
  .pdf-viewer {
    width: 100%;
    height: clamp(26rem, 62vh, 44rem);
  }

  .pdf-viewer iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
