---
interface Props {
  href: string;
  external?: boolean;
  download?: boolean;
}

const { href, external = false, download = false } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class="button" download={download || undefined} {...externalAttrs}>
  <slot />
</a>

<style>
  /* 평소에는 차분하게, 마우스를 올렸을 때만 강조색. 버튼은 이 한 가지 모양만 쓴다 */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 3.25rem;
    padding: 0 var(--space-5);
    background: var(--ink);
    color: var(--bg);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    white-space: nowrap;
    transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease,
      color var(--t-hover) ease;
  }

  .button:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .button:active {
    transform: scale(0.98);
  }
</style>
