---
interface Props {
  href: string;
  external?: boolean;
}

const { href, external = false } = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a href={href} class="text-link" {...externalAttrs}><slot /></a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1.5px;
    transition: color var(--t-hover) ease;
  }

  .text-link:hover {
    color: var(--accent);
  }
</style>
