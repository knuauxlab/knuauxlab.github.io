---
// 연차 보고서식 기준선 레이아웃: 왼쪽에 라벨, 오른쪽에 내용.
// 모든 서브페이지가 같은 세로 기준선을 공유한다.
interface Props {
  heading: string;
  id?: string;
  /** 연도처럼 크게 보여줄 라벨 */
  large?: boolean;
}

const { heading, id, large = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
// 기준선 아래에 전체 폭으로 놓을 내용 (예: 넓게 보여줄 PDF 미리보기)
const hasBelow = Astro.slots.has('below');
---

<section class="section" id={id} aria-labelledby={id ? `${id}-heading` : undefined}>
  <div class="wrap axis" data-reveal>
    <div class="axis-aside">
      <h2 class:list={['section-label', { 'is-large': large }]} id={id ? `${id}-heading` : undefined}>
        {heading}
      </h2>
      {hasAside && <div class="section-aside muted nums"><slot name="aside" /></div>}
    </div>
    <div class="axis-main">
      <slot />
    </div>
  </div>
  {
    hasBelow && (
      <div class="wrap section-below" data-reveal>
        <slot name="below" />
      </div>
    )
  }
</section>

<style>
  .section {
    padding-block: var(--section-tight);
  }

  .section-label {
    font-size: var(--fs-heading);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-heading);
  }

  .section-label.is-large {
    font-size: var(--fs-display);
    line-height: 1;
    letter-spacing: var(--ls-tight);
  }

  .section-aside {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
  }

  .section-below {
    margin-top: var(--space-6);
  }
</style>
