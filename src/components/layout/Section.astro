---
// 연차 보고서식 기준선 레이아웃: 왼쪽에 라벨, 오른쪽에 내용.
// 모든 서브페이지가 같은 세로 기준선을 공유한다.
interface Props {
  heading: string;
  id?: string;
  /** 연도처럼 크게 보여줄 라벨 */
  large?: boolean;
}

const { heading, id, large = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="section" id={id} aria-labelledby={id ? `${id}-heading` : undefined}>
  <div class="wrap axis" data-reveal>
    <div class="axis-aside">
      <h2 class:list={["section-label", { "is-large": large }]} id={id ? `${id}-heading` : undefined}>{heading}</h2>
      {hasAside && <div class="section-aside small muted nums"><slot name="aside" /></div>}
    </div>
    <div class="axis-main">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }

  .section-label {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .section-label.is-large {
    font-size: clamp(2.75rem, 1.6rem + 4vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .section-aside {
    margin-top: 0.4rem;
  }
</style>
