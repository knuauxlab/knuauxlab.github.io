---
const navLinks = [
  { href: '/', label: '홈' },
  { href: '/news', label: '소식' },
  { href: '/members', label: '구성원' },
  { href: '/publications', label: '논문' },
  { href: '/projects', label: '프로젝트' },
  { href: '/joinus', label: '모집' },
  { href: '/contact', label: '연락처' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand-mark" aria-label="AUX Lab 홈">
      <img src="/logo.png" alt="AUX Lab 로고" class="brand-logo" width="110" height="45" />
      <span class="brand-name">AUX Lab</span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span class="menu-toggle-label">메뉴</span>
    </button>

    <nav id="primary-navigation" class="site-nav" aria-label="주 메뉴" data-site-nav>
      <ul class="nav-list">
        {
          navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-current': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupNavigation() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-site-nav]');
    if (!toggle || !nav || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      nav.classList.toggle('is-open', !expanded);
      const label = toggle.querySelector('.menu-toggle-label');
      if (label) label.textContent = expanded ? '메뉴' : '닫기';
    });
  }

  setupNavigation();
  document.addEventListener('astro:page-load', setupNavigation);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    color: var(--ink);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5rem;
    gap: 1.5rem;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-logo {
    height: 2.4rem;
    width: auto;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.6rem 1rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .nav-link.is-current {
    background: var(--ink);
    color: var(--bg);
  }

  .menu-toggle {
    display: none;
    padding: 0.5rem 0.9rem;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-display);
    font-size: var(--step-small);
    font-weight: 700;
  }

  @media (max-width: 60em) {
    .menu-toggle {
      display: inline-flex;
      align-items: center;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--ink);
      color: var(--bg);
      padding: 1rem var(--margin) 1.5rem;
    }

    .site-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
    }

    .nav-link {
      padding: 0.7rem 0.9rem;
      font-size: var(--step-body);
    }

    .nav-link:hover {
      color: var(--bg);
      background: #232730;
    }

    .nav-link.is-current {
      background: var(--accent);
      color: var(--accent-ink);
    }
  }
</style>
