---
import TextLink from '../ui/TextLink.astro';
import { getLabInfo } from '../../utils/lab';
import { withBase } from '../../utils/url';

const lab = await getLabInfo();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <img src={withBase('/logo.png')} alt={`${lab.name} logo`} class="footer-logo" width="96" height="40" />
      <p class="muted">{lab.affiliation}</p>
      <p class="muted">{lab.address}</p>
    </div>

    <div class="footer-right">
      <TextLink href={`mailto:${lab.email}`}>{lab.email}</TextLink>
      {lab.phone && <p class="muted nums">{lab.phone}</p>}
    </div>
  </div>
</footer>

<style>
  /*
   * 페이지의 끝을 알리는 띠. 글 덩어리마다 까는 회색 상자와는 다르게, 푸터만 예외로 둔다.
   * 문서 맨 끝에 놓인다. 내용이 짧은 페이지에서는 body의 flex 레이아웃 덕분에 화면 맨 아래에 붙는다.
   */
  .site-footer {
    background: var(--surface-strong);
    padding-block: var(--space-6);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3) var(--space-6);
  }

  .footer-logo {
    display: block;
    height: 2.5rem;
    margin-bottom: var(--space-3);
    width: auto;
    object-fit: contain;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  @media (max-width: 48em) {
    .footer-right {
      align-items: flex-start;
    }
  }
</style>
