---
import { getLabInfo } from '../../utils/lab';

const lab = await getLabInfo();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <div class="footer-brand-row">
        <img src="/logo.png" alt="AUX Lab 로고" class="footer-logo" width="96" height="40" />
        <p class="footer-brand">{lab.name} — {lab.fullName}</p>
      </div>
      <p class="muted">{lab.affiliation}</p>
      <p class="muted">{lab.address}</p>
    </div>

    <div class="footer-right">
      <a href={`mailto:${lab.email}`} class="text-link">{lab.email}</a>
      {lab.phone && <p class="muted nums">{lab.phone}</p>}
    </div>
  </div>
</footer>

<style>
  /* 배경 없이 여백으로만 본문과 구분한다 */
  .site-footer {
    margin-top: var(--space-7);
    padding-block: var(--space-7);
    font-size: var(--fs-small);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }

  .footer-brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .footer-logo {
    height: 1.9rem;
    width: auto;
    object-fit: contain;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: var(--fw-bold);
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  @media (max-width: 48em) {
    .footer-right {
      align-items: flex-start;
    }
  }
</style>
