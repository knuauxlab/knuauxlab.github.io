---
import TextLink from '../ui/TextLink.astro';
import { getLabInfo } from '../../utils/lab';
import { withBase } from '../../utils/url';

const lab = await getLabInfo();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <div class="footer-brand-row">
        <img src={withBase('/logo.png')} alt="AUX Lab 로고" class="footer-logo" width="96" height="40" />
        <p class="footer-brand">{lab.name} — {lab.fullName}</p>
      </div>
      <p class="muted">{lab.affiliation}</p>
      <p class="muted">{lab.address}</p>
    </div>

    <div class="footer-right">
      <TextLink href={`mailto:${lab.email}`}>{lab.email}</TextLink>
      {lab.phone && <p class="muted nums">{lab.phone}</p>}
    </div>
  </div>
</footer>

<script>
  // 푸터가 화면 아래에 붙어 있으므로, 키보드로 이동한 요소가 푸터 뒤에 가려지지 않게
  // 푸터의 실제 높이를 읽어 scroll-padding-bottom(global.css)에 반영한다.
  function trackFooterHeight() {
    const footer = document.querySelector<HTMLElement>('.site-footer');
    if (!footer) return;
    const update = () =>
      document.documentElement.style.setProperty('--footer-h', `${footer.offsetHeight}px`);
    update();
    new ResizeObserver(update).observe(footer);
  }

  trackFooterHeight();
</script>

<style>
  /*
   * 페이지의 끝을 알리는 띠. 글 덩어리마다 까는 회색 상자와는 다르게, 푸터만 예외로 둔다.
   * sticky + bottom: 0 이라 스크롤하는 동안 화면 아래에 항상 붙어 있고, 문서 끝에서는 본문을
   * 가리지 않고 제자리에 놓인다. 화면을 덜 차지하도록 위아래 여백과 줄 간격만 줄였다.
   */
  .site-footer {
    position: sticky;
    bottom: 0;
    z-index: 30;
    background: var(--surface-strong);
    padding-block: var(--space-4);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3) var(--space-6);
  }

  .footer-brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .footer-logo {
    height: 1.9rem;
    width: auto;
    object-fit: contain;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: var(--fw-bold);
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }

  @media (max-width: 48em) {
    .footer-right {
      align-items: flex-start;
    }
  }
</style>
