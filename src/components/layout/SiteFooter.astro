---
import { getLabInfo } from '../../utils/lab';

const lab = await getLabInfo();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-left">
      <div class="footer-brand-row">
        <img src="/logo.png" alt="AUX Lab 로고" class="footer-logo" width="96" height="40" />
        <p class="footer-brand">{lab.name} — {lab.fullName}</p>
      </div>
      <p class="small muted">{lab.affiliation}</p>
      <p class="small muted">{lab.address}</p>
    </div>

    <div class="footer-right">
      <a href={`mailto:${lab.email}`} class="text-link">{lab.email}</a>
      {lab.phone && <p class="small muted nums">{lab.phone}</p>}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-strong);
    color: var(--ink);
    padding-block: 3.5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }

  .footer-brand-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.5rem;
  }

  .footer-logo {
    height: 1.9rem;
    width: auto;
    object-fit: contain;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: var(--step-lead);
    font-weight: 700;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  @media (max-width: 48em) {
    .footer-right {
      align-items: flex-start;
    }
  }
</style>
