---
interface Props {
  heading: string;
  lead?: string;
}

const { heading, lead } = Astro.props;
---

<header class="page-header">
  <div class="wrap axis">
    <h1 class="page-title">{heading}</h1>
    {lead && <p class="lead page-lead">{lead}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(0.5rem, 2vw, 1.5rem);
  }

  .page-title {
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .page-lead {
    align-self: end;
    color: var(--muted);
  }
</style>
