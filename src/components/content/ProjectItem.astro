---
interface Props {
  title: string;
  summary?: string;
}

const { title, summary } = Astro.props;
const hasBody = Astro.slots.has('default');
---

<article class="project-item">
  <h3 class="project-title">{title}</h3>
  {summary && <p class="body-copy muted">{summary}</p>}
  {hasBody && <div class="body-copy"><slot /></div>}
</article>

<style>
  .project-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-title {
    font-size: var(--fs-subtitle);
    line-height: var(--lh-snug);
    font-weight: var(--fw-bold);
    letter-spacing: -0.01em;
  }
</style>
