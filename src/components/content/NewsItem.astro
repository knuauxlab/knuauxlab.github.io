---
import Tag from '../ui/Tag.astro';
import { monthLabel } from '../../utils/date';
import { newsCategoryLabels } from '../../utils/labels';

interface Props {
  date: string;
  title: string;
  category: string;
}

const { date, title, category } = Astro.props;
const hasBody = Astro.slots.has('default');
---

<li class="news-item">
  <span class="news-date nums">{monthLabel(date)}</span>
  <div class="news-body">
    <h3 class="news-title">{title}</h3>
    <Tag>{newsCategoryLabels[category] ?? category}</Tag>
    {hasBody && <div class="small muted news-extra"><slot /></div>}
  </div>
</li>

<style>
  .news-item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: 1.25rem;
    align-items: baseline;
  }

  .news-date {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--muted);
  }

  .news-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .news-title {
    font-size: var(--step-lead);
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .news-extra {
    margin-top: 0.4rem;
  }

  @media (max-width: 36em) {
    .news-item {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.25rem;
    }
  }
</style>
