---
import Tag from '../ui/Tag.astro';
import { monthLabel } from '../../utils/date';
import { newsCategoryLabels } from '../../utils/labels';

interface Props {
  date: string;
  title: string;
  category: string;
}

const { date, title, category } = Astro.props;
const hasBody = Astro.slots.has('default');
---

<li class="news-item">
  <span class="news-date nums">{monthLabel(date)}</span>
  <div class="news-body">
    <h3 class="news-title">{title}</h3>
    <Tag>{newsCategoryLabels[category] ?? category}</Tag>
    {hasBody && <div class="muted news-extra"><slot /></div>}
  </div>
</li>

<style>
  .news-item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: var(--space-5);
    align-items: baseline;
  }

  .news-date {
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: var(--fw-semibold);
    color: var(--muted);
  }

  .news-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .news-title {
    font-size: var(--fs-subtitle);
    line-height: var(--lh-snug);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
  }

  .news-extra {
    margin-top: var(--space-1);
  }

  @media (max-width: 36em) {
    .news-item {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-1);
    }
  }
</style>
