---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../../utils/url';

interface Props {
  title: string;
  subtitle?: string;
  date: string;
  dateLabel?: string;
  location?: string;
  images?: ImageMetadata[];
}

const { title, subtitle, date, dateLabel, location, images = [] } = Astro.props;
const displayDate = dateLabel ?? date.replace(/-/g, '.');
---

<article class="album-entry" data-album-carousel>
  <div class="album-info">
    <h2 class="album-title">{title}</h2>
    <div class="album-meta muted">
      {subtitle && <p class="album-subtitle">{subtitle}</p>}
      <p class="album-date nums">{displayDate}</p>
      {location && <p class="album-location">{location}</p>}
    </div>
  </div>

  <div class="album-media">
    <div class="album-stage">
      {
        images.length > 0 ? (
          images.map((img, idx) => (
            <div class:list={['album-slide', { 'is-active': idx === 0 }]} data-slide={idx}>
              <Image
                src={img}
                alt={`${title} (${idx + 1}/${images.length})`}
                width={1080}
                height={680}
                loading={idx === 0 ? 'eager' : 'lazy'}
                class="album-img"
              />
            </div>
          ))
        ) : (
          <div class="album-slide is-active">
            <div class="album-placeholder" aria-hidden="true">
              <img src={withBase('/logo.png')} alt="" class="placeholder-logo" width="120" height="50" />
            </div>
          </div>
        )
      }

      {
        images.length > 1 && (
          <>
            <button type="button" class="carousel-btn prev" aria-label="Previous photo" data-prev>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6" />
              </svg>
            </button>
            <button type="button" class="carousel-btn next" aria-label="Next photo" data-next>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </button>
          </>
        )
      }
    </div>

    {
      images.length > 1 && (
        <div class="carousel-dots" role="tablist" aria-label="Slide navigation">
          {images.map((_, idx) => (
            <button
              type="button"
              class:list={['carousel-dot', { 'is-active': idx === 0 }]}
              aria-label={`Photo ${idx + 1}`}
              data-dot={idx}
            />
          ))}
        </div>
      )
    }
  </div>
</article>

<script>
  function setupAlbumCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>('[data-album-carousel]');
    carousels.forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');

      if (slides.length <= 1) return;

      let current = 0;

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((el, i) => el.classList.toggle('is-active', i === current));
        dots.forEach((el, i) => el.classList.toggle('is-active', i === current));
      };

      prevBtn?.addEventListener('click', () => show(current - 1));
      nextBtn?.addEventListener('click', () => show(current + 1));
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => show(idx));
      });
    });
  }

  setupAlbumCarousels();
  document.addEventListener('astro:page-load', setupAlbumCarousels);
</script>

<style>
  .album-entry {
    display: grid;
    grid-template-columns: minmax(14rem, 4fr) minmax(0, 8fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: var(--space-5);
    align-items: start;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .album-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .album-title {
    font-size: var(--fs-heading);
    line-height: 1.25;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-heading);
  }

  .album-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-small);
  }

  .album-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
  }

  .album-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--surface);
    overflow: hidden;
  }

  .album-slide {
    display: none;
    width: 100%;
    height: 100%;
  }

  .album-slide.is-active {
    display: block;
  }

  .album-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .album-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--surface);
  }

  .placeholder-logo {
    height: 2.5rem;
    width: auto;
    opacity: 0.22;
    filter: grayscale(100%);
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(15, 17, 21, 0.55);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--t-hover) ease, transform var(--t-press) ease;
    z-index: 2;
  }

  .carousel-btn:hover {
    background: rgba(184, 32, 32, 0.85);
  }

  .carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel-btn.prev {
    left: 0.875rem;
  }

  .carousel-btn.next {
    right: 0.875rem;
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .carousel-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #d0d4dc;
    transition: background-color var(--t-hover) ease, transform var(--t-hover) ease;
  }

  .carousel-dot.is-active {
    background: var(--ink);
    transform: scale(1.15);
  }

  .carousel-dot:hover {
    background: var(--accent);
  }

  @media (max-width: 52em) {
    .album-entry {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

