---
// 서브페이지 공통 틀: 공통 셸 + 페이지 제목.
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';

interface Props {
  title: string;
  /** 제목 아래 한 줄 소개. 없으면 description을 그대로 보여준다 */
  lead?: string;
  /** 검색 결과와 공유 미리보기에 보이는 한두 문장 설명 */
  description?: string;
  noindex?: boolean;
}

const { title, lead, description, noindex } = Astro.props;
---

<BaseLayout title={`${title} — AUX Lab`} description={description} noindex={noindex}>
  <PageHeader heading={title} lead={lead ?? description} />
  <slot />
</BaseLayout>
