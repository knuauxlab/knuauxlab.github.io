#!/bin/sh
# 커밋 전에 빌드, 링크 검사, CMS 설정 검사(npm run build:ci)를 돌리고, 하나라도 실패하면 커밋을 막는다.
# CI가 같은 검사를 하지만, 깨진 상태가 커밋 이력에 들어가기 전에 여기서 잡는다.
#
# 급하게 건너뛰어야 하면: git commit --no-verify  (CI에서는 여전히 걸린다)

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 문서와 설정 메모만 바뀐 커밋은 사이트 결과에 영향이 없으니 건너뛴다
needs_check=$(printf '%s\n' "$staged" | grep -v -E '^(docs/|README\.md$|CLAUDE\.md$|\.claude/|\.gitattributes$|\.githooks/)' || true)
if [ -z "$needs_check" ]; then
  echo "[pre-commit] 문서만 바뀌어 검사를 건너뜁니다."
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "[pre-commit] node_modules가 없습니다. 먼저 npm install을 실행하세요." >&2
  exit 1
fi

# 검사는 작업 폴더를 대상으로 하므로, 커밋에 담기지 않는 변경이 섞여 있으면 알려준다
if ! git diff --quiet; then
  echo "[pre-commit] 주의: 커밋에 담기지 않은 변경이 있습니다. 검사는 작업 폴더 전체를 기준으로 하므로" >&2
  echo "             커밋될 내용만으로는 빌드가 안 될 수도 있습니다." >&2
fi

echo "[pre-commit] 빌드와 검사를 실행합니다 (npm run build:ci) ..."
log=$(mktemp)
if npm run build:ci >"$log" 2>&1; then
  # 터미널 색상 코드를 지우고 핵심 결과만 보여준다
  sed 's/\x1b\[[0-9;]*m//g' "$log" | grep -E 'page\(s\) built|링크 검사|CMS 설정 검사' | sed 's/^/[pre-commit] /'
  rm -f "$log"
  exit 0
fi

echo "" >&2
echo "[pre-commit] 실패: 커밋을 막았습니다. 아래 오류를 고친 뒤 다시 커밋하세요." >&2
sed 's/\x1b\[[0-9;]*m//g' "$log" | tail -n 25 >&2
rm -f "$log"
exit 1
